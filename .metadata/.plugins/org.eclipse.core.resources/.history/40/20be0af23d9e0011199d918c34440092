package com.example.hospital.service;

import java.time.LocalDate;
import java.util.List;
import java.util.Set;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.hospital.exception.DoctorNotAvailableException;
import com.example.hospital.exception.DuplicateAppointmentException;
import com.example.hospital.exception.InvalidAppointmentDateException;
import com.example.hospital.exception.InvalidRequestException;
import com.example.hospital.model.Appointment;

@Service
public class AppointmentService {
	
	@Autowired
	private Appointment appointmentRepository;
	
	//Doctor currently not taking new appointment(demo data for DoctorNotAvailableException)
	private static final Set<String> UNAVAILABLE_DOCTORS = Set.of("dr. house", "dr. Strange");
	
	public List<Appointment> getAllAppointments(){
		return appointmentRepository.findAll();
	}
	
	public Appointment getAppointmentById(Long id) {
		return appointmentRepository.findById(id).orElseThrow(() -> new AppointmentNotFoundException(id));
	}
	
	public List<Appointment> getAppointmentByDoctor(String doctorName){
		List<Appointment> appointment = appointmentRepository.findByDoctorNameIgnoreCase(doctorName);
		if(appointment.isEmpty()) {
			throw new InvalidRequestException("No appointments found for doctor: "+doctorName);
		}
		return appointments;
	}
	
	public Appointment bookAppointment(Appointment appointment) {
		validateAppointment(appointment);
		
		if(UNAVAILABLE_DOCTORS.contains(appointment.getDoctorName().trim().toLowerCase())) {
			throw new DoctorNotAvailableException(appointment.getDoctorName());
		}
		
		List<Appointment> existing = appointmentRepository.findByDoctorNameIgnoreCaseAndAppointmentDate(appointment.getDoctorName(), appointment.getAppointmentDate());
		if(!existing.isEmpty()) {
			throw new DuplicateAppointmentException(appointment.getDoctorName(), appointment.getAppointmentDate().toString());;
		}
		return appointmentRepository.save(appointment);
	}
	
	public Appointment updateAppointment(Long id, Appointment updateDetails) {
		Appointment appointment = getAppointmentById(id);
		validateAppointment(updateDetails);
		
		appointment.setPatientName(updateDetails.getPatientName());
		appointment.setDoctorName(updateDetails.getDoctorName());
		appointment.setDisease(updateDetails.getDisease());
		appointment.setAppointmentDate(updateDetails.getAppointmentDate());
		
		return appointmentRepository.save(appointment);
	}
	
	public void deletAppointment(Long id) {
		Appointment appointment = getAppointmentById(id);
		appointmentRepository.delete(appointment);
	}
	
	private void validateAppointment(Appointment appointment) {
		if(appointment.getAppointmentDate() != null && appointment.getAppointmentDate().isBefore(LocalDate.now())) {
			throw new InvalidAppointmentDateException("Appointment date " +appointment.getAppointmentDate()+ "cannot be in the past");
		}
	}
}