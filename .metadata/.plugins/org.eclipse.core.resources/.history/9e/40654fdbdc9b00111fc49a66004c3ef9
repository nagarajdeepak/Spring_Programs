package com.example.studentmarks.service;

import java.util.HashMap;
import java.util.Map;

import org.springframework.stereotype.Service;
import com.example.studentmarks.model.student;

@Service
public class studentservice {
	public Map<String, object> calculateMarks(student student){
		int total = student.getJava() + student.getSpring() + student.getSql();
		
		double average = total / 3.0;
		
		String result;
		
		if(average >= 40) {
			result = "PASS";
		} else {
			result = "FAIL";
		}
		
		Map<String, Object> response = new HashMap<>();
		
		response.put("Student ID", student.getId());
		response.put("Student Name", student.getName());
		response.put("Java Marks", student.getJava());
		response.put("Spring Marks", student.getSpring());
		response.put("SQL Marks", student.getSql());
		response.put("Total Mark", total);
		response.put("Average Marks", average);
		response.put("Result", result);
		
		return response;
	}
}
